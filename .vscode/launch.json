{
  "version": "0.2.0",
  "configurations": [
    {
      // Config.dart reads compile-time defines; without this flag the app shows "Missing config".
      "name": "AutoContact",
      "type": "dart",
      "request": "launch",
      "cwd": "app",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define-from-file=config.json"]
    }
  ]
}
